# ==============================
# PHP-BindManager Environment
# ==============================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# APP
APP_NAME="PHP-BindManager"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_KEY=

# DATABASE
# Relative paths are automatically resolved from project root. Absolute paths are also supported.
DB_PATH=Database/bindmanager.sqlite
DB_WAL=true
DB_FOREIGN_KEYS=true

# SESSION
SESSION_NAME=pbm_session
SESSION_LIFETIME=7200
# Set SESSION_SECURE=false for local HTTP dev/testing; set true in production with HTTPS
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# SECURITY
CSRF_TOKEN_LIFETIME=3600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=300
BRUTE_FORCE_MAX=5
BRUTE_FORCE_LOCKOUT=900
PASSWORD_MIN_LENGTH=12

# BIND9
BIND9_ZONES_DIR=/etc/bind/zones
BIND9_CONF_DIR=/etc/bind
BIND9_NAMED_CONF=/etc/bind/named.conf.local
BIND9_CHECKZONE=/usr/sbin/named-checkzone
BIND9_CHECKCONF=/usr/sbin/named-checkconf
BIND9_RNDC=/usr/sbin/rndc
BIND9_KEYGEN=/usr/sbin/dnssec-keygen
BIND9_SIGNZONE=/usr/sbin/dnssec-signzone
BIND9_USER=bind

# LOGGING
LOG_LEVEL=warning
LOG_PATH=Storage/Logs
LOG_MAX_FILES=30

# CACHE
CACHE_DRIVER=file
CACHE_TTL=3600
CACHE_PATH=Storage/Cache

# MAIL
MAIL_DRIVER=smtp
MAIL_HOST=smtp.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="PHP-BindManager"

# API
API_ENABLED=true
API_VERSION=v1
API_RATE_LIMIT=300
API_TOKEN_LIFETIME=31536000
