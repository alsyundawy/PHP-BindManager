root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.php]
indent_style = space
indent_size = 4
php_diagnostic_php408 = none
php_diagnostic_php0408 = none
php_diagnostic_php410 = none
php_diagnostic_php0410 = none
php_diagnostic_php412 = none
php_diagnostic_php0412 = none
php_diagnostic_php413 = none
php_diagnostic_php0413 = none

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4
